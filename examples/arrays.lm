// v2: arrays are heap objects shared by reference
let grid = [[1, 2, 3], [4, 5, 6]];
let row = grid[1];
row[0] = 40;            // row and grid[1] are the same array
print grid;             // [[1, 2, 3], [40, 5, 6]]

let squares = [];
let i = 0;
while i < 6 { push(squares, i * i); i = i + 1; }
print squares;          // [0, 1, 4, 9, 16, 25]

let me = ["self"];
push(me, me);
print me;               // ["self", [...]]
