// Strings live on a garbage-collected heap. Run this, then
// tick "GC stress" to collect before every allocation and compare.
fn wrap(s) {
  return "[" + s + "]";   // builds a new string: garbage once unused
}

let s = "";
let i = 0;
while i < 3000 {
  s = s + "x";           // appends in place: no new object
  let w = wrap(s);       // a fresh copy each iteration
  i = i + 1;
}
print wrap("jinso");
print s == s;
